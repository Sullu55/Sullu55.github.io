---
import type { Week } from '../data/weeks';

interface Props {
  week: Week;
}
const { week } = Astro.props;

// Renderiza **texto en negrita** dentro de strings
function renderBold(text: string): string {
  return text.replace(/\*\*([^*]+)\*\*/g, '<strong class="text-slate-100 font-semibold">$1</strong>');
}
---
<section id={`semana-${week.n}`} class="scroll-mt-24 rounded-2xl border border-slate-800 bg-slate-900/40 p-6 md:p-10">
  {/* Encabezado */}
  <header class="flex flex-wrap items-baseline gap-4">
    <span class="grid h-14 w-14 place-items-center rounded-2xl bg-gradient-to-br from-indigo-500 to-fuchsia-500 text-xl font-black text-white shadow-lg shadow-indigo-500/30">
      {week.n}
    </span>
    <div class="flex-1 min-w-0">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-400">
        Semana {week.n}
      </p>
      <h3 class="mt-1 text-2xl font-bold text-slate-100 md:text-3xl">
        {week.title}
      </h3>
    </div>
  </header>

  {/* Resumen */}
  <p class="mt-6 text-base leading-relaxed text-slate-300 md:text-lg">
    {week.summary}
  </p>

  {/* Apuntes detallados */}
  <div class="mt-8">
    <h4 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-fuchsia-400">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      Apuntes detallados
    </h4>
    <div class="mt-3 space-y-3">
      {week.details.map((d) => (
        <p class="rounded-lg border-l-2 border-fuchsia-500/50 bg-slate-950/30 py-2 pl-4 pr-3 text-sm leading-relaxed text-slate-300 md:text-base" set:html={renderBold(d)}></p>
      ))}
    </div>
  </div>

  {/* Grid 2 columnas: Contenidos + Conceptos */}
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    <div>
      <h4 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-indigo-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        Contenidos del sílabo
      </h4>
      <ul class="mt-3 space-y-2 text-sm text-slate-300">
        {week.topics.map((t) => (
          <li class="flex gap-2.5">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-indigo-400" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>{t}</span>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-emerald-400">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        Conceptos clave
      </h4>
      <dl class="mt-3 space-y-2.5 text-sm">
        {week.concepts.map((c) => (
          <div class="rounded-lg border border-slate-800 bg-slate-950/30 px-3 py-2">
            <dt class="font-mono text-xs font-semibold text-emerald-300">{c.name}</dt>
            <dd class="mt-0.5 text-slate-300">{c.desc}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  {/* Bloque de código */}
  <div class="mt-8">
    <h4 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-slate-400">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
      </svg>
      {week.codeTitle}
    </h4>
    <pre class="mt-3 overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/80 p-5 text-xs leading-relaxed text-slate-200 md:text-sm"><code class={`language-${week.codeLang}`}>{week.code}</code></pre>
  </div>

  {/* Cómo lo apliqué */}
  {week.applied && (
    <div class="mt-8 rounded-xl border border-indigo-500/30 bg-gradient-to-br from-indigo-500/10 to-fuchsia-500/5 p-5">
      <h4 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-indigo-300">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Cómo lo apliqué
      </h4>
      <p class="mt-2 text-sm leading-relaxed text-slate-200 md:text-base">
        {week.applied}
      </p>
      {week.myProject && (
        <a
          href={week.myProject.href}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-indigo-300 hover:text-indigo-200"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.1-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.2.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>
          {week.myProject.name} ↗
        </a>
      )}
    </div>
  )}
</section>
