---
import type { Week } from '../data/weeks';

interface Props {
  week: Week;
}
const { week } = Astro.props;
---
<section id={`semana-${week.n}`} class="scroll-mt-24 rounded-2xl border border-slate-800 bg-slate-900/40 p-6 md:p-8">
  <header class="flex flex-wrap items-baseline gap-3">
    <span class="grid h-10 w-10 place-items-center rounded-lg bg-gradient-to-br from-indigo-500 to-fuchsia-500 text-sm font-black text-white shadow-lg shadow-indigo-500/30">
      {week.n}
    </span>
    <div>
      <p class="text-xs font-medium uppercase tracking-wider text-indigo-400">
        Semana {week.n}
      </p>
      <h3 class="text-xl font-semibold text-slate-100 md:text-2xl">
        {week.title}
      </h3>
    </div>
  </header>

  <p class="mt-5 text-slate-300 leading-relaxed">{week.summary}</p>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-400">Contenidos</h4>
      <ul class="mt-3 space-y-2 text-sm text-slate-300">
        {week.topics.map((t) => (
          <li class="flex gap-2">
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-indigo-400"></span>
            <span>{t}</span>
          </li>
        ))}
      </ul>
      {week.myProject && (
        <div class="mt-5 rounded-lg border border-indigo-500/30 bg-indigo-500/10 p-3 text-sm">
          <p class="text-indigo-300">
            <strong class="font-semibold">Mi proyecto:</strong>{' '}
            <a href={week.myProject.href} target="_blank" rel="noopener" class="underline underline-offset-2 hover:text-indigo-200">
              {week.myProject.name} ↗
            </a>
          </p>
        </div>
      )}
    </div>

    <div>
      <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-400">
        {week.codeTitle}
      </h4>
      <pre class="mt-3 overflow-x-auto rounded-lg border border-slate-800 bg-slate-950/80 p-4 text-xs leading-relaxed text-slate-200"><code class={`language-${week.codeLang}`}>{week.code}</code></pre>
    </div>
  </div>
</section>
