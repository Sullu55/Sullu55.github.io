---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---
<article class="group relative flex flex-col overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition hover:border-indigo-500/40 hover:bg-slate-900/80">
  {project.highlight && (
    <span class="absolute right-4 top-4 rounded-full bg-fuchsia-500/15 px-2.5 py-0.5 text-xs font-medium text-fuchsia-300 ring-1 ring-fuchsia-500/30">
      Destacado
    </span>
  )}

  <div class="flex items-start gap-3">
    <div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-gradient-to-br from-indigo-500/30 to-fuchsia-500/30 text-indigo-300 ring-1 ring-indigo-500/30">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
      </svg>
    </div>
    <div class="min-w-0 flex-1">
      <h3 class="text-lg font-semibold text-slate-100">{project.title}</h3>
      {project.week && (
        <p class="mt-0.5 text-xs font-medium uppercase tracking-wider text-indigo-400">
          {project.week}
        </p>
      )}
    </div>
  </div>

  <p class="mt-4 text-sm leading-relaxed text-slate-300">{project.description}</p>

  <ul class="mt-4 space-y-1.5 text-sm text-slate-400">
    {project.features.map((f) => (
      <li class="flex gap-2">
        <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-indigo-400"></span>
        <span>{f}</span>
      </li>
    ))}
  </ul>

  <div class="mt-5 flex flex-wrap gap-1.5">
    {project.stack.map((s) => (
      <span class="rounded-md bg-slate-800/80 px-2 py-0.5 text-xs text-slate-300 ring-1 ring-slate-700">
        {s}
      </span>
    ))}
  </div>

  <div class="mt-6 flex items-center gap-3 pt-4 border-t border-slate-800">
    {project.private ? (
      <span class="inline-flex items-center gap-1.5 rounded-md bg-amber-500/10 px-2 py-1 text-xs font-medium text-amber-300 ring-1 ring-amber-500/30">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        Código privado
      </span>
    ) : (
      <a
        href={project.repo}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-indigo-400 hover:text-indigo-300"
      >
        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.3 3.6 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.1-.4-.6-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.2.9 2.3v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/>
        </svg>
        Ver código
      </a>
    )}
    {project.demo && (
      <a
        href={project.demo}
        target="_blank"
        rel="noopener"
        class="ml-auto inline-flex items-center gap-1.5 text-sm font-semibold text-indigo-300 hover:text-indigo-200"
      >
        Demo en vivo
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    )}
  </div>
</article>
