---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const featured = projects.filter((p) => p.highlight);
---
<Layout title="Anyelo Sulluchuco — Portfolio · Ingeniería de Sistemas UNCP">
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-12 md:pt-24 md:pb-20">
    <div class="max-w-3xl">
      <p class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-xs font-medium text-indigo-300">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-indigo-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-indigo-500"></span>
        </span>
        Disponible para prácticas y proyectos
      </p>
      <h1 class="mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl md:text-6xl">
        Hola, soy <span class="bg-gradient-to-r from-indigo-400 to-fuchsia-400 bg-clip-text text-transparent">Anyelo Sulluchuco</span>
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-slate-300 md:text-xl">
        Estudiante de <strong class="text-slate-100">Ingeniería de Sistemas</strong> en la Universidad Nacional del Centro del Perú.
        Construyo aplicaciones web modernas con <strong class="text-slate-100">React, Next.js, TypeScript</strong> y backends sobre Supabase.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="/proyectos" class="inline-flex items-center gap-2 rounded-lg bg-indigo-500 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-indigo-500/30 transition hover:bg-indigo-400">
          Ver mis proyectos
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/curso" class="inline-flex items-center gap-2 rounded-lg border border-slate-700 bg-slate-900/50 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-slate-500">
          Curso UNCP — Semanas 1-8
        </a>
        <a href="mailto:zacsullu@gmail.com" class="inline-flex items-center gap-2 px-3 py-2.5 text-sm font-medium text-slate-400 transition hover:text-slate-100">
          zacsullu@gmail.com
        </a>
      </div>
    </div>

    <dl class="mt-16 grid grid-cols-2 gap-4 sm:max-w-2xl sm:grid-cols-4">
      {[
        { k: '5+', v: 'Proyectos publicados' },
        { k: '8', v: 'Semanas de curso' },
        { k: 'IX', v: 'Ciclo (2026-I)' },
        { k: 'UNCP', v: 'Universidad' },
      ].map((s) => (
        <div class="rounded-xl border border-slate-800 bg-slate-900/40 px-4 py-3">
          <dt class="text-2xl font-bold text-white">{s.k}</dt>
          <dd class="text-xs text-slate-400">{s.v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex items-end justify-between">
      <div>
        <h2 class="text-2xl font-bold text-white md:text-3xl">Proyectos destacados</h2>
        <p class="mt-2 text-slate-400">Una selección de lo que estoy construyendo.</p>
      </div>
      <a href="/proyectos" class="hidden text-sm font-medium text-indigo-400 hover:text-indigo-300 sm:inline">
        Ver todos →
      </a>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-12">
    <div class="rounded-2xl border border-slate-800 bg-gradient-to-br from-slate-900/80 to-slate-900/30 p-8 md:p-12">
      <h2 class="text-2xl font-bold text-white md:text-3xl">Stack que manejo</h2>
      <p class="mt-3 max-w-2xl text-slate-400">
        Tecnologías que uso día a día en proyectos académicos y personales.
      </p>
      <div class="mt-8 flex flex-wrap gap-2">
        {[
          'JavaScript', 'TypeScript', 'React', 'Next.js', 'Astro', 'Vite',
          'Tailwind CSS', 'Node.js', 'Supabase', 'PostgreSQL', 'Python',
          'HTML5', 'CSS3', 'Git', 'GitHub Actions', 'Vercel'
        ].map((t) => (
          <span class="rounded-lg border border-slate-700 bg-slate-800/60 px-3 py-1.5 text-sm text-slate-200">
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>
</Layout>
